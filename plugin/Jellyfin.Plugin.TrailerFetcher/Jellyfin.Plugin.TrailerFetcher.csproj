<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.TrailerFetcher</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- BasePlugin<T>.Version reads the COMPILED ASSEMBLY's own version metadata
         (Assembly.GetName().Version), not build.yaml/manifest.json - leaving this
         unset silently defaults to .NET's "1.0.0.0", which does not match the
         version Jellyfin installed/tracks from the repository manifest. That
         mismatch caused real instability: the dashboard reporting "1.0.0.0" after
         a task run or restart, and uninstall failing outright. package.sh reads
         this value (not build.yaml) as the source of truth and keeps build.yaml in
         sync, so this is the ONE place the version needs bumping. -->
    <Version>0.8.28.0</Version>
    <AssemblyVersion>0.8.28.0</AssemblyVersion>
    <FileVersion>0.8.28.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned to the tester's exact server version (10.11.11); Jellyfin.Controller
         10.11.x only targets net9.0, unlike the 10.10.x line's net8.0. -->
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="10.11.11">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Common" Version="10.11.11">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

</Project>
