# ==========================================
# Jellyfin Trailer Sync - Configuration
# ==========================================

# Base URL of your Jellyfin server (e.g. http://192.168.1.100:8096)
JELLYFIN_URL="http://<YOUR-JELLYFIN-IP>:8096"

# Your Jellyfin API Key (Dashboard > API Keys)
API_KEY="<YOUR_JELLYFIN_API_KEY>"

# --- Path Mappings (Jellyfin Server Path -> Local Mac Mount Path) ---
# Map server-side media paths to local file paths (JSON object)
PATH_MAPPINGS='{
    "/media/Movies/": "/Volumes/Media/Movies/"
}'

# Optional: Browser to extract YouTube cookies for geobypass / bot detection
# Options: "firefox", "chrome", "edge", "safari", "brave", or "none" (default: "firefox")
COOKIE_BROWSER="firefox"
